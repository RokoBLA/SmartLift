rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Korisnik čita i piše samo svoj dokument i njegove podkolekcije.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
